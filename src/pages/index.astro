---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title="ydy8989 — ML blog">
  <h1 class="text-3xl font-bold tracking-tight mb-2">ydy8989</h1>
  <p class="mb-10" style="color: var(--fg-muted)">머신러닝 학습 기록 · 글 {posts.length}편</p>

  <div class="divide-y" style="border-color: var(--border)">
    {
      posts.map((post) => (
        <a href={`/${post.data.slug}/`} class="group block py-4">
          <div class="flex items-baseline gap-4">
            <time class="text-sm font-mono shrink-0 tabular-nums" style="color: var(--fg-muted)">
              {fmt(post.data.pubDate)}
            </time>
            <span class="font-medium group-hover:underline underline-offset-4 decoration-1">
              {post.data.title}
            </span>
          </div>
          <p class="text-sm mt-1.5 line-clamp-2" style="color: var(--fg-muted)">
            {post.data.description}
          </p>
        </a>
      ))
    }
  </div>
</Base>
