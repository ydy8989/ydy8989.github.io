---
import Base from '../layouts/Base.astro';
import ProjectCoverflow from '../components/ProjectCoverflow.astro';
import { profile } from '../data/profile';
---

<Base title="ydy8989 — Doyeon Yoon" description={`${profile.nameEn} · ${profile.role} · 포트폴리오`}>
  <section class="text-center mb-8 sm:mb-12">
    <p class="font-mono text-sm" style="color: var(--fg-muted)">
      {profile.nameEn} · {profile.role} @ 컬리
    </p>
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mt-3">
      What is your <span style="color: var(--accent)">ATTN</span>?
    </h1>
  </section>

  <ProjectCoverflow />

  <div class="flex items-center justify-center gap-3 mt-12 text-sm">
    <a
      href="/about/"
      class="px-4 py-2 rounded-md border hover:opacity-70 transition-opacity"
      style="border-color: var(--border)"
    >
      About →
    </a>
    <a
      href={profile.resumeUrl}
      class="px-4 py-2 rounded-md font-mono hover:opacity-70 transition-opacity"
      style="background: var(--accent); color: #fff"
    >
      Resume ↓
    </a>
  </div>
</Base>
